<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 知识星球帖子同步：每 15 分钟运行一次 scripts/zsxq-sync.mjs（只读）。
     安装：cp 到 ~/Library/LaunchAgents/ 后 launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.wsstudio.zsxq-sync.plist
     日志：~/Library/Logs/zsxq-sync.log -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.wsstudio.zsxq-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/ws_studio/Downloads/invest-workbench/scripts/zsxq-sync.mjs</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/ws_studio</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/ws_studio/Library/Logs/zsxq-sync.log</string>
  <key>StandardErrorPath</key><string>/Users/ws_studio/Library/Logs/zsxq-sync.log</string>
</dict>
</plist>
